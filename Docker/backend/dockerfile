# ---------- Build Stage ----------
FROM golang:1.26.2-alpine AS builder

WORKDIR /app

# 必要なパッケージ
RUN apk add --no-cache git

# ① go.mod と go.sum を先にコピー
# - これにより依存を先に解決でき、キャッシュ効率が良くなる
COPY go.mod go.sum ./

# ② 依存関係をダウンロード
RUN go mod download

# ③ ソースコードコピー
COPY . .

# ④ （ソースをコピー後の追加操作は不要）

# ⑤ ビルド
# 実際のエントリポイントは cmd/server/main.go
RUN go build -o main ./cmd/server

# ---------- Runtime Stage ----------
FROM alpine:3.19

WORKDIR /app

# タイムゾーン・証明書
RUN apk add --no-cache \
  ca-certificates \
  tzdata \
  && update-ca-certificates

# ビルドしたバイナリをコピー
COPY --from=builder /app/main .

# ログディレクトリ
RUN mkdir -p /app/logs

# 非rootユーザー作成
RUN adduser -D appuser
RUN chown -R appuser:appuser /app

USER appuser

EXPOSE 8080

CMD ["./main"]